extends ../layout
include ../mixins/error

block content 
  if errorMsg 
    +error(errorMsg)
  .upload-box
    .record-video 
      button#show-preview Click to See Preview
      #video-preview.hidden
        video#preview
        button#recordBtn
          .record-background
          .record-inner
        button#stopBtn.hidden
        button#pauseBtn.hidden
          img(src="/assets/pause.svg", alt="Pause").pauseIcon
          img(src="/assets/play.svg", alt="Resume").hidden.resumeIcon
          
        button#downloadBtn.hidden
          img(src="/assets/download.svg", alt="Download")
        button#restartBtn.hidden
          img(src="/assets/restart.svg", alt="Restart")


    form(method="post", enctype="multipart/form-data")
      div.file-input-box
        input.upload-file-name(value="Select video file")
        label(for="video") Select Video File 
        input.upload-file-input(id="video",type="file", name="video", accept="video/*", required)
      label(for="title") Title
      input(id="title", placeholder="Video Title", type="text", required, name="title", maxlength=80)
      label(for="description") Description
      textarea(id="description", placeholder="Video Description", required, name="description", minlength=20)
      label(for="hashtags") Hashtags (Separate multiple values with a comma)
      input(id="hashtags", placeholder="Hashtags", type="text", required, name="hashtags")
      button(type="submit") Upload Video!

block scripts 
  script(src="/static/js/recorder.js") 